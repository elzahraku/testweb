-- ─────────────────────────────────────────────
-- 1. APP CONFIG
-- Menyimpan semua konfigurasi admin panel
-- ─────────────────────────────────────────────
CREATE TABLE IF NOT EXISTS app_config (
  key         TEXT PRIMARY KEY,
  value       TEXT NOT NULL DEFAULT '',
  updated_at  TIMESTAMPTZ DEFAULT now()
);

